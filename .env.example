APP_ENV=local
APP_SECRET=replace-this-with-a-long-random-local-value
APP_BASE_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://127.0.0.1:5173

USER_AGENT=NorthstarPersonalResearch/1.0
CRAWL_MIN_INTERVAL_SECONDS=1
MAX_PRODUCTS_PER_SCAN=100
MAX_RESPONSE_BYTES=10000000
LOCAL_TASK_WORKERS=1
MIRROR_PRODUCT_IMAGES=false

# Optional official Meta Ad Library integration
META_ADS_ACCESS_TOKEN=
META_GRAPH_VERSION=v25.0

# Optional GetHookd public API integration (requires an eligible paid plan/token)
GETHOOKD_API_TOKEN=

# Optional official Similarweb traffic integration
SIMILARWEB_API_KEY=
