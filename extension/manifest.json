{
  "manifest_version": 3,
  "name": "Northstar Public Ad Capture",
  "version": "0.2.0",
  "description": "Save public ad evidence from the current page into your local Northstar library.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_title": "Save public ad to Northstar",
    "default_popup": "popup.html"
  }
}
